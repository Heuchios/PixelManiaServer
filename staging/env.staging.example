# PixelMania STAGING environment.
# provision_staging.sh renders this into /home/pixelmania-stg/PixelManiaServer/shared/.env
# and substitutes the __PLACEHOLDER__ values. Do not copy this onto production.
#
# Every value here that differs from production exists to keep staging from touching
# production state. If you change one, change its production counterpart's isolation too.

# --- Identity -----------------------------------------------------------------
# Node stays local-only; Cloudflare -> Caddy -> Node, same as production.
HOST=127.0.0.1
PORT=__STG_PORT__
PUBLIC_BASE_URL=https://__STG_HOSTNAME__
PUBLIC_WS_URL=wss://__STG_HOSTNAME__/ws
SERVER_INSTANCE_ID=pixelmania-staging
SERVER_INSTANCE_WS_URL=wss://__STG_HOSTNAME__/ws

# Staging must never force-update a work-in-progress editor build mid-test.
# The deploy script overrides SERVER_CLIENT_VERSION per release via .release-env.
SERVER_CLIENT_VERSION=1.0.4
MIN_CLIENT_VERSION=1.0.0
UPDATE_URL=https://pixelmaniagame.com

# --- Storage: the isolation that actually matters -----------------------------
POSTGRES_ENABLED=true
POSTGRES_AUTHORITATIVE=true
ALLOW_AUTHORITATIVE_JSON_FALLBACK=false
REQUIRE_POSTGRES_AUTHORITATIVE_FOR_GAMEPLAY=true
# True so an empty staging database bootstraps itself before the first data clone.
POSTGRES_AUTO_BOOTSTRAP=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=__STG_DB__
POSTGRES_USER=__STG_DB_USER__
POSTGRES_PASSWORD=__STG_DB_PASSWORD__
POSTGRES_SSL=false
# Same schema name as production so a pg_dump restores without rewriting.
# The database name is what separates the environments.
POSTGRES_SCHEMA=pixelmania
# Small pool: staging shares one PostgreSQL server with production.
POSTGRES_POOL_MAX=4
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=8000
POSTGRES_WRITE_QUEUE_MAX=1000
ALLOW_LEGACY_PLAYER_STATE_IMPORT=false
ALLOW_LEGACY_WORLD_STATE_IMPORT=false

PIXELMANIA_DATA_DIR=__STG_DATA_DIR__

# Separate Redis logical DB *and* separate key prefix. Either alone would do;
# both means a FLUSHDB aimed at staging cannot reach production's sessions.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/__STG_REDIS_DB__
REDIS_KEY_PREFIX=__STG_REDIS_PREFIX__
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_ACTION_LOCK_TTL_MS=5000
REDIS_PRESENCE_TTL_MS=45000
REDIS_ACTIVE_SESSION_TTL_MS=120000

# --- Topology: single process ------------------------------------------------
# One Node process serves login and gameplay, so there is nothing to route between.
# Leave enforcement off; turn it on only if you stand up staging-a/-b to chase a
# routing bug (see world_route_epoch_fencing notes).
WORLD_ROUTE_ENFORCEMENT_ENABLED=false
REDIS_REQUIRED_FOR_ROUTE_ENFORCEMENT=false
WORLD_ADMISSION_TTL_MS=45000
WORLD_ROUTE_TTL_MS=45000
MAX_PLAYERS_PER_WORLD=50

NETFOX_MOVEMENT_ENABLED=false
NETFOX_MOVEMENT_ALLOW_STATIC_FALLBACK=true
NETFOX_TRUSTED_PLAYER_STATE_ENABLED=true
CUSTOM_TRUSTED_PLAYER_STATE_ENABLED=false
TRUSTED_MOVEMENT_REQUIRE_JOINED_WORLD=true
TRUSTED_MOVEMENT_ALLOWLIST_ENABLED=false
NETFOX_SPAWN_TICKET_SECRET=__STG_NETFOX_SECRET__

# --- Gameplay knobs: keep identical to production ----------------------------
# These change how the game feels and how packets are shaped. If staging is meant
# to predict production behaviour, they must not drift.
PLAYER_POSITION_BROADCAST_INTERVAL_MS=16
PLAYER_POSITION_BATCHING_ENABLED=true
PLAYER_POSITION_BATCH_MIN_CLIENT_VERSION=1.0.3
PLAYER_POSITION_BATCH_MAX_ITEMS=64
PLAYER_POSITION_MAX_BUFFERED_AMOUNT=262144
PLAYER_POSITION_RESUME_BUFFERED_AMOUNT=65536
PLAYER_POSITION_DELIVERY_RETRY_MS=25
PLAYER_INTEREST_MANAGEMENT_ENABLED=true
PLAYER_INTEREST_RADIUS_PIXELS=2560
PLAYER_INTEREST_LEAVE_RADIUS_PIXELS=3072
PLAYER_ACTION_INTEREST_MANAGEMENT_ENABLED=true
WORLD_UPDATE_BATCHING_ENABLED=true
WORLD_UPDATE_BATCH_MIN_CLIENT_VERSION=1.0.3
WORLD_UPDATE_BATCH_MAX_ITEMS=64
WORLD_UPDATE_BATCH_INTERVAL_MS=16
WORLD_STATE_STREAMING_ENABLED=true
WORLD_STATE_STREAM_MIN_CLIENT_VERSION=1.0.4
WORLD_STATE_STREAM_TARGET_PACKET_BYTES=49152
WORLD_STATE_STREAM_MAX_CHUNKS=256
DROP_INTEREST_MANAGEMENT_ENABLED=true
DROP_INTEREST_RADIUS_PIXELS=2560
DROP_INTEREST_LEAVE_RADIUS_PIXELS=3072
DROP_INTEREST_SYNC_INTERVAL_MS=250
SERVER_WEBSOCKET_MAX_BUFFERED_AMOUNT=4194304
MOVEMENT_COLLISION_GUARD_ENABLED=true
BLOCK_DAMAGE_RESET_MS=3500
ACTION_RATE_LIMIT_MS=25
MIN_BLOCK_BREAK_INTERVAL_MS=75
MIN_BLOCK_PLACE_INTERVAL_MS=75

# --- Background work: off, to stay off production's CPU ----------------------
# Staging shares four vCPUs with the live game. Nothing here is needed to test a feature.
WORLD_SNAPSHOT_STORAGE=local
WORLD_SNAPSHOT_INTERVAL_MINUTES=0
WORLD_SNAPSHOT_STARTUP_RUN=false
WORLD_SNAPSHOT_MAX_WORLDS_PER_CYCLE=5
WORLD_JSON_BACKUP_WHEN_PG_READY=false
ANTI_DUPE_AUDIT_INTERVAL_MS=0
WORLD_HONORS_ENABLED=true
WORLD_HONOR_NETWORK_HASH_SECRET=__STG_HONOR_SECRET__

# --- Accounts and mail -------------------------------------------------------
# Blank SMTP so staging can never email a real player. Consequence: account
# verification mail does not arrive, so log in with an account cloned from
# production rather than registering a fresh one.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania Staging <no-reply@invalid.local>
TEST_EMAIL_TO=

SESSION_TOKEN_TTL_MINUTES=1440
SESSION_REFRESH_TOKEN_TTL_MINUTES=43200
ACCOUNT_ONE_ACTIVE_SESSION=false
LOGIN_ATTEMPT_LIMIT_IP=200
LOGIN_ATTEMPT_LIMIT_ACCOUNT=100
LOGIN_ATTEMPT_WINDOW_SECONDS=300
TOKEN_LOGIN_ATTEMPT_LIMIT_IP=500
TOKEN_LOGIN_ATTEMPT_LIMIT_ACCOUNT=100

DEV_PIN_REQUIRED=false
ADMIN_2FA_REQUIRED=false
ADMIN_COMMAND_CONFIRMATION_REQUIRED=false
DEBUG_PLAYER_PROGRESSION=false
DESIGNER_USERNAMES=
