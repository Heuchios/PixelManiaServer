# PixelMania private ops dashboard. Do not expose this directly to the public internet.
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_PORT=9090

# Legacy token fallback. Prefer password login for production.
# node -e "console.log(require('crypto').createHash('sha256').update('your-long-token').digest('hex'))"
OPS_DASHBOARD_TOKEN=
OPS_DASHBOARD_TOKEN_HASH=

# Required for real login. Generate with: npm run ops:password
OPS_DASHBOARD_ADMIN_USERNAME=admin
OPS_DASHBOARD_ADMIN_EMAIL=
OPS_DASHBOARD_ADMIN_PASSWORD_HASH=
# Persistent account/session file. Created automatically from the env values above.
OPS_DASHBOARD_ACCOUNT_FILE=
# Optional; defaults to deriving the session signer from the password hash.
OPS_DASHBOARD_SESSION_SECRET=
OPS_DASHBOARD_SESSION_TTL_HOURS=12
# Keep false for localhost/SSH tunnel. Set true only when serving over HTTPS.
OPS_DASHBOARD_COOKIE_SECURE=false
OPS_DASHBOARD_PUBLIC_BASE_URL=http://127.0.0.1:9090
OPS_DASHBOARD_EMAIL_VERIFICATION_TTL_MINUTES=60
OPS_DASHBOARD_PASSWORD_RESET_TTL_MINUTES=30
OPS_DASHBOARD_MIN_PASSWORD_LENGTH=10
OPS_DASHBOARD_LOGIN_CODE_ENABLED=false
OPS_DASHBOARD_LOGIN_CODE_TTL_MINUTES=10
OPS_DASHBOARD_ACCOUNT_BACKUP_DIR=/var/backups/pixelmania/ops-dashboard
OPS_DASHBOARD_ACCOUNT_BACKUP_RETENTION_DAYS=30
OPS_DASHBOARD_ACCOUNT_BACKUP_SCHEDULE=17 * * * *

# Optional public HTTPS hostname. DNS must point to the droplet before running:
# sudo bash scripts/install_ops_dashboard_https.sh ops.pixelmaniagame.com
OPS_DASHBOARD_DOMAIN=ops.pixelmaniagame.com

# Optional SMTP for ops email verification and password reset links. If blank,
# links are written to PM2 logs instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania Ops <no-reply@pixelmania.local>

OPS_DASHBOARD_HEALTH_URL=http://127.0.0.1:8080/health
OPS_DASHBOARD_ROUTE_TARGETS=ws-a|pixelmania-a|http://127.0.0.1:18091/health|wss://api.pixelmaniagame.com/ws-a;ws-b|pixelmania-b|http://127.0.0.1:18092/health|wss://api.pixelmaniagame.com/ws-b
OPS_DASHBOARD_PM2_APP=pixelmania
OPS_DASHBOARD_PM2_ECOSYSTEM=ecosystem.config.js

# Keep false until the dashboard is protected behind HTTPS + admin-only access.
OPS_DASHBOARD_ALLOW_CONTROL=false
# Comma-separated actions the dashboard may run when controls are enabled.
OPS_DASHBOARD_ALLOWED_ACTIONS=restart,start,stop,deploy,rollback
# Comma-separated PM2 apps restarted by the Restart button.
OPS_DASHBOARD_RESTART_APPS=pixelmania,pixelmania-a,pixelmania-b
# Leave blank to use the release-aware defaults from ecosystem.ops.config.js.
OPS_DASHBOARD_RESTART_COMMAND=
OPS_DASHBOARD_START_COMMAND=
# Stop intentionally stops main, ws-a, and ws-b. The dashboard requires typing STOP first.
OPS_DASHBOARD_STOP_COMMAND=for app in pixelmania pixelmania-a pixelmania-b; do pm2 stop "$app" || true; done; pm2 save
# Keep false so Stop is refused while the main server or route servers report players online.
OPS_DASHBOARD_ALLOW_STOP_WITH_PLAYERS=false
# Keep false so Deploy is refused while the main server or route servers report players online.
OPS_DASHBOARD_ALLOW_DEPLOY_WITH_PLAYERS=false
# Keep false so Rollback is refused while the main server or route servers report players online.
OPS_DASHBOARD_ALLOW_ROLLBACK_WITH_PLAYERS=false
# Comma-separated actions that require typing the uppercase action name before they run.
OPS_DASHBOARD_CONFIRM_ACTIONS=stop,deploy,rollback

# Versioned artifacts are uploaded from the trusted Windows workstation. Keep
# this blank so the dashboard cannot mutate the production checkout in place.
OPS_DASHBOARD_DEPLOY_COMMAND=
OPS_DASHBOARD_DEPLOY_CWD=

# Leave blank to use the stable current/previous release rollback command.
OPS_DASHBOARD_ROLLBACK_COMMAND=
OPS_DASHBOARD_ROLLBACK_CWD=

# Optional. PM2 logs are used when this is blank.
OPS_DASHBOARD_LOG_FILE=
OPS_DASHBOARD_AUDIT_LOG_PATH=
