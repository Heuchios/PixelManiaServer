PORT=8080
HOST=127.0.0.1
PUBLIC_BASE_URL=https://api.pixelmaniagame.com

# Exported Godot builds must send this version or newer before the server accepts login/gameplay.
SERVER_CLIENT_VERSION=1.0.1
MIN_CLIENT_VERSION=1.0.1
UPDATE_URL=https://pixelmaniagame.com
BLOCK_DAMAGE_RESET_MS=3500
SESSION_TOKEN_TTL_MINUTES=1440

# SMTP email sending for account verification.
# Use your email provider's SMTP settings here. Do not commit real .env values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania <no-reply@example.com>

# Optional developer/admin hardening.
# Prefer DEV_PIN_HASH over DEV_PIN in production. DEV_PIN_HASH is sha256(pin).
ADMIN_LOG_PATH=
DEV_PIN_REQUIRED=false
DEV_PIN=
DEV_PIN_HASH=
DEV_PIN_UNLOCK_TTL_MINUTES=15

# Optional save-data location override for production.
# PIXELMANIA_DATA_DIR=/var/lib/pixelmania
