# Production with Cloudflare/Caddy should keep Node local-only.
# Use HOST=0.0.0.0 only for a container/LAN setup where firewall rules are intentional.
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://api.pixelmaniagame.com
PUBLIC_WS_URL=wss://api.pixelmaniagame.com/ws

# Exported Godot builds must send this version or newer before the server accepts login/gameplay.
SERVER_CLIENT_VERSION=1.0.1
MIN_CLIENT_VERSION=1.0.1
UPDATE_URL=https://pixelmaniagame.com
BLOCK_DAMAGE_RESET_MS=3500
SESSION_TOKEN_TTL_MINUTES=1440

# SMTP email sending for account verification.
# Use your email provider's SMTP settings here. Do not commit real .env values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania <no-reply@example.com>
# Optional recipient for `npm run email:test`.
TEST_EMAIL_TO=

# Optional developer/admin hardening.
# Prefer DEV_PIN_HASH over DEV_PIN in production. DEV_PIN_HASH is sha256(pin).
ADMIN_LOG_PATH=
DEV_PIN_REQUIRED=false
DEV_PIN=
DEV_PIN_HASH=
DEV_PIN_UNLOCK_TTL_MINUTES=15
DEBUG_PLAYER_PROGRESSION=false

# Optional save-data location override for production.
# PIXELMANIA_DATA_DIR=/var/lib/pixelmania

# PostgreSQL is the production source of truth when enabled and ready.
# JSON files remain local migration/backups; set POSTGRES_AUTHORITATIVE=false only for emergency fallback.
POSTGRES_ENABLED=false
POSTGRES_AUTHORITATIVE=true
POSTGRES_AUTO_BOOTSTRAP=false
# POSTGRES_CONNECTION_STRING=postgres://user:password@host:5432/database
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_SCHEMA=pixelmania
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=8000
POSTGRES_WRITE_QUEUE_MAX=1000
# POSTGRES_BOOTSTRAP_SQL_PATH=docs/postgres_security_foundation.sql

# Optional Redis live cache/rate-limit/session layer.
# Not required for single-node development; add it before multi-node production.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=pixelmania
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_ACTION_LOCK_TTL_MS=5000
REDIS_PRESENCE_TTL_MS=45000
REDIS_ACTIVE_SESSION_TTL_MS=120000

# Optional future object storage target for large world snapshot archives.
# Current snapshots are stored locally and mirrored into PostgreSQL world_snapshots.
WORLD_SNAPSHOT_STORAGE=local
