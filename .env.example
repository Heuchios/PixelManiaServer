# Production with Cloudflare/Caddy should keep Node local-only.
# Use HOST=0.0.0.0 only for a container/LAN setup where firewall rules are intentional.
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://api.pixelmaniagame.com
PUBLIC_WS_URL=wss://api.pixelmaniagame.com/ws

# Exported Godot builds must send this version or newer before the server accepts login/gameplay.
SERVER_CLIENT_VERSION=1.0.1
MIN_CLIENT_VERSION=1.0.1
UPDATE_URL=https://pixelmaniagame.com
BLOCK_DAMAGE_RESET_MS=3500
SESSION_TOKEN_TTL_MINUTES=1440
SESSION_REFRESH_TOKEN_TTL_MINUTES=43200
ACCOUNT_ONE_ACTIVE_SESSION=true
LOGIN_ATTEMPT_LIMIT_IP=20
LOGIN_ATTEMPT_LIMIT_ACCOUNT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Bot/rate-limit protection. Redis is used when enabled; otherwise the server falls back to per-socket buckets.
BOT_BLOCK_PLACE_LIMIT=12
BOT_BLOCK_PLACE_WINDOW_SECONDS=1
BOT_BLOCK_BREAK_LIMIT=16
BOT_BLOCK_BREAK_WINDOW_SECONDS=1
BOT_PICKUP_ATTEMPT_LIMIT=12
BOT_PICKUP_ATTEMPT_WINDOW_SECONDS=1
BOT_CHAT_MESSAGE_LIMIT=3
BOT_CHAT_MESSAGE_WINDOW_SECONDS=1
BOT_TRADE_REQUEST_LIMIT=20
BOT_TRADE_REQUEST_WINDOW_SECONDS=60
BOT_WORLD_JOIN_LIMIT=20
BOT_WORLD_JOIN_WINDOW_SECONDS=60
BOT_VENDING_PURCHASE_LIMIT=5
BOT_VENDING_PURCHASE_WINDOW_SECONDS=1
BOT_RATE_LIMIT_SECURITY_LOG_WINDOW_MS=5000

PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
PASSWORD_SCRYPT_KEYLEN=64

# SMTP email sending for account verification.
# Use your email provider's SMTP settings here. Do not commit real .env values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania <no-reply@example.com>
# Optional recipient for `npm run email:test`.
TEST_EMAIL_TO=

# Optional developer/admin hardening.
# Prefer DEV_PIN_HASH over DEV_PIN in production. DEV_PIN_HASH is sha256(pin).
ADMIN_LOG_PATH=
CRASH_REPORT_PATH=
DEV_PIN_REQUIRED=false
DEV_PIN=
DEV_PIN_HASH=
DEV_PIN_UNLOCK_TTL_MINUTES=15
# Optional TOTP admin 2FA. Use ADMIN_2FA_SECRETS for per-admin secrets:
# ADMIN_2FA_SECRETS=uso:JBSWY3DPEHPK3PXP,otheradmin:BASE32SECRET
ADMIN_2FA_REQUIRED=false
ADMIN_2FA_SECRET=
ADMIN_2FA_SECRETS=
ADMIN_2FA_UNLOCK_TTL_MINUTES=15
ADMIN_2FA_WINDOW_STEPS=1
ADMIN_COMMAND_COOLDOWN_MS=1000
ADMIN_COMMAND_CONFIRMATION_REQUIRED=false
ADMIN_COMMAND_CONFIRMATION_TTL_SECONDS=60
ADMIN_COMMAND_CONFIRMATION_ACTIONS=clear,resetworld,reset_world,reworld,give,remove,ban,unban,mute,unmute,itemfreeze,itemunfreeze,itemretire,itemtransfer,itemflag
DEBUG_PLAYER_PROGRESSION=false

# Optional save-data location override for production.
# PIXELMANIA_DATA_DIR=/var/lib/pixelmania

# PostgreSQL is the production source of truth when enabled and ready.
# JSON files remain local migration/backups; set POSTGRES_AUTHORITATIVE=false only for emergency fallback.
POSTGRES_ENABLED=false
POSTGRES_AUTHORITATIVE=true
POSTGRES_AUTO_BOOTSTRAP=false
# POSTGRES_CONNECTION_STRING=postgres://user:password@host:5432/database
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_SCHEMA=pixelmania
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=8000
POSTGRES_WRITE_QUEUE_MAX=1000
# POSTGRES_BOOTSTRAP_SQL_PATH=docs/postgres_security_foundation.sql

# Optional tracked-item anti-dupe audit scanner.
# Set ANTI_DUPE_AUDIT_INTERVAL_MS=0 to disable the background scanner.
ANTI_DUPE_AUDIT_INTERVAL_MS=900000
ANTI_DUPE_AUDIT_LIMIT=100
ANTI_DUPE_AUDIT_LOG_CLEAN=false

# Optional periodic world snapshot interval in minutes.
# 0 disables checkpoint scheduling.
WORLD_SNAPSHOT_INTERVAL_MINUTES=15
# Limit snapshot work per cycle so small droplets do not snapshot/upload every loaded world at once.
# 0 means all loaded worlds each cycle.
WORLD_SNAPSHOT_MAX_WORLDS_PER_CYCLE=5
# Keep false in production unless you explicitly want a checkpoint shortly after every restart.
WORLD_SNAPSHOT_STARTUP_RUN=false

# Optional Redis live cache/rate-limit/session layer.
# Not required for single-node development; add it before multi-node production.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=pixelmania
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_ACTION_LOCK_TTL_MS=5000
REDIS_PRESENCE_TTL_MS=45000
REDIS_ACTIVE_SESSION_TTL_MS=120000

# Optional object storage target for large world snapshot archives.
# When set to spaces, snapshots are written locally first, then uploaded to Spaces/S3.
# PostgreSQL remains the permanent truth database and stores the snapshot checksum + storage URI.
WORLD_SNAPSHOT_STORAGE=local
# WORLD_SNAPSHOT_SPACES_REGION=tor1
# WORLD_SNAPSHOT_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
# WORLD_SNAPSHOT_SPACES_TARGET=s3://pixelmania-backups/world_snapshots
# WORLD_SNAPSHOT_POSTGRES_INLINE=false
