# Production with Cloudflare/Caddy should keep Node local-only.
# Use HOST=0.0.0.0 only for a container/LAN setup where firewall rules are intentional.
# The versioned deployer supplies these two values. Do not set them manually.
PIXELMANIA_RELEASE_ROOT=
PIXELMANIA_RELEASE_ID=
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://api.pixelmaniagame.com
PUBLIC_WS_URL=wss://api.pixelmaniagame.com/ws
# Optional per-process routing identity for multi-instance world ownership.
# Leave blank for local/single-node; set stable unique values per backend instance when sharding.
SERVER_INSTANCE_ID=
SERVER_INSTANCE_WS_URL=

# Exported Godot builds must send this version or newer before the server accepts login/gameplay.
SERVER_CLIENT_VERSION=1.0.1
MIN_CLIENT_VERSION=1.0.1
UPDATE_URL=https://pixelmaniagame.com
BLOCK_DAMAGE_RESET_MS=3500
ACTION_RATE_LIMIT_MS=25
MIN_BLOCK_BREAK_INTERVAL_MS=75
MIN_BLOCK_PLACE_INTERVAL_MS=75

# Live network scaling knobs. Keep batching on for production; set the enabled flag to 0 for rollback.
MAX_PLAYERS_PER_WORLD=50
PLAYER_POSITION_BROADCAST_INTERVAL_MS=16
PLAYER_POSITION_BATCHING_ENABLED=true
PLAYER_POSITION_BATCH_MIN_CLIENT_VERSION=1.0.3
PLAYER_POSITION_BATCH_MAX_ITEMS=64
PLAYER_INTEREST_MANAGEMENT_ENABLED=true
PLAYER_INTEREST_RADIUS_PIXELS=2560
PLAYER_INTEREST_LEAVE_RADIUS_PIXELS=3072
PLAYER_ACTION_INTEREST_MANAGEMENT_ENABLED=true
WORLD_UPDATE_BATCHING_ENABLED=true
WORLD_UPDATE_BATCH_MIN_CLIENT_VERSION=1.0.3
WORLD_UPDATE_BATCH_MAX_ITEMS=64
WORLD_UPDATE_BATCH_INTERVAL_MS=16
DROP_INTEREST_MANAGEMENT_ENABLED=true
DROP_INTEREST_RADIUS_PIXELS=2560
DROP_INTEREST_LEAVE_RADIUS_PIXELS=3072
DROP_INTEREST_SYNC_INTERVAL_MS=250
# Slow-client protection. Sends are skipped when a socket queues more than this many bytes.
SERVER_WEBSOCKET_MAX_BUFFERED_AMOUNT=4194304

SESSION_TOKEN_TTL_MINUTES=1440
SESSION_REFRESH_TOKEN_TTL_MINUTES=43200
ACCOUNT_ONE_ACTIVE_SESSION=true
LOGIN_ATTEMPT_LIMIT_IP=20
LOGIN_ATTEMPT_LIMIT_ACCOUNT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Forgiving gameplay limits still reject sustained automated floods. Redis is used when enabled;
# otherwise the server falls back to per-socket buckets.
BOT_BLOCK_PLACE_LIMIT=75
BOT_BLOCK_PLACE_WINDOW_SECONDS=1
BOT_BLOCK_BREAK_LIMIT=75
BOT_BLOCK_BREAK_WINDOW_SECONDS=1
BOT_PICKUP_ATTEMPT_LIMIT=30
BOT_PICKUP_ATTEMPT_WINDOW_SECONDS=1
BOT_CHAT_MESSAGE_LIMIT=20
BOT_CHAT_MESSAGE_WINDOW_SECONDS=1
BOT_PLAYER_PUNCH_LIMIT=20
BOT_PLAYER_PUNCH_WINDOW_SECONDS=1
BOT_TRADE_REQUEST_LIMIT=120
BOT_TRADE_REQUEST_WINDOW_SECONDS=60
BOT_WORLD_JOIN_LIMIT=120
BOT_WORLD_JOIN_WINDOW_SECONDS=60
BOT_VENDING_PURCHASE_LIMIT=50
BOT_VENDING_PURCHASE_WINDOW_SECONDS=1
BOT_RATE_LIMIT_SECURITY_LOG_WINDOW_MS=5000
INVENTORY_SEED_PLACE_LIMIT=60
INVENTORY_SEED_PLACE_WINDOW_SECONDS=1
INVENTORY_SEED_SPLICE_LIMIT=60
INVENTORY_SEED_SPLICE_WINDOW_SECONDS=1
INVENTORY_SEED_HARVEST_LIMIT=50
INVENTORY_SEED_HARVEST_WINDOW_SECONDS=1
IDEMPOTENCY_TTL_MS=10000
IDEMPOTENCY_TTL_MS_CRITICAL=2500
IDEMPOTENCY_TTL_MS_WORLD_ACTION=1200
IDEMPOTENCY_TTL_MS_COMBAT=600

PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
PASSWORD_SCRYPT_KEYLEN=64

# SMTP email sending for account verification.
# Use your email provider's SMTP settings here. Do not commit real .env values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelMania <no-reply@example.com>
# Optional recipient for `npm run email:test`.
TEST_EMAIL_TO=

# Optional developer/admin hardening.
# UCE and Rayan are built-in Designers. Add any extra Designer usernames here.
DESIGNER_USERNAMES=
# Prefer DEV_PIN_HASH over DEV_PIN in production. DEV_PIN_HASH is sha256(pin).
ADMIN_LOG_PATH=
CRASH_REPORT_PATH=
DEV_PIN_REQUIRED=false
DEV_PIN=
DEV_PIN_HASH=
DEV_PIN_UNLOCK_TTL_MINUTES=15
# Optional TOTP admin 2FA. Use ADMIN_2FA_SECRETS for per-admin secrets:
# ADMIN_2FA_SECRETS=uso:JBSWY3DPEHPK3PXP,otheradmin:BASE32SECRET
ADMIN_2FA_REQUIRED=false
ADMIN_2FA_SECRET=
ADMIN_2FA_SECRETS=
ADMIN_2FA_UNLOCK_TTL_MINUTES=15
ADMIN_2FA_WINDOW_STEPS=1
ADMIN_COMMAND_COOLDOWN_MS=1000
ADMIN_COMMAND_CONFIRMATION_REQUIRED=false
ADMIN_COMMAND_CONFIRMATION_TTL_SECONDS=60
ADMIN_COMMAND_CONFIRMATION_ACTIONS=clear,resetworld,reset_world,reworld,give,remove,ban,unban,mute,unmute,itemfreeze,itemunfreeze,itemretire,itemtransfer,itemflag
DEBUG_PLAYER_PROGRESSION=false

# Optional save-data location override for production.
# PIXELMANIA_DATA_DIR=/var/lib/pixelmania

# PostgreSQL is the production source of truth when enabled and ready.
# JSON files remain local migration/backups; set POSTGRES_AUTHORITATIVE=false only for emergency fallback.
POSTGRES_ENABLED=false
POSTGRES_AUTHORITATIVE=true
# Keep false in production. True allows the server to accept players from JSON if authoritative Postgres is down.
ALLOW_AUTHORITATIVE_JSON_FALLBACK=false
# Local JSON-only dev can leave this false. Production should keep it true so login/gameplay packets are rejected until Postgres is authoritative and ready.
REQUIRE_POSTGRES_AUTHORITATIVE_FOR_GAMEPLAY=false
POSTGRES_AUTO_BOOTSTRAP=false
ALLOW_LEGACY_WORLD_STATE_IMPORT=false
# POSTGRES_CONNECTION_STRING=postgres://user:password@host:5432/database
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_SCHEMA=pixelmania
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=8000
POSTGRES_WRITE_QUEUE_MAX=1000
# POSTGRES_BOOTSTRAP_SQL_PATH=docs/postgres_security_foundation.sql

# Optional tracked-item anti-dupe audit scanner.
# Set ANTI_DUPE_AUDIT_INTERVAL_MS=0 to disable the background scanner.
ANTI_DUPE_AUDIT_INTERVAL_MS=900000
ANTI_DUPE_AUDIT_LIMIT=100
ANTI_DUPE_AUDIT_LOG_CLEAN=false

# Optional periodic world snapshot interval in minutes.
# 0 disables checkpoint scheduling.
WORLD_SNAPSHOT_INTERVAL_MINUTES=15
# Limit snapshot work per cycle so small droplets do not snapshot/upload every loaded world at once.
# 0 means all loaded worlds each cycle.
WORLD_SNAPSHOT_MAX_WORLDS_PER_CYCLE=5
# Keep false in production unless you explicitly want a checkpoint shortly after every restart.
WORLD_SNAPSHOT_STARTUP_RUN=false
WORLD_JSON_BACKUP_WHEN_PG_READY=false
WORLD_JSON_BACKUP_DEBOUNCE_MS=1000
WORLD_NON_CRITICAL_WORLD_SAVE_DEBOUNCE_MS=1200

# Optional Redis live cache/rate-limit/session layer.
# Not required for single-node development; add it before multi-node production.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=pixelmania
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_ACTION_LOCK_TTL_MS=5000
REDIS_PRESENCE_TTL_MS=45000
REDIS_ACTIVE_SESSION_TTL_MS=120000
WORLD_ADMISSION_TTL_MS=45000
WORLD_ROUTE_TTL_MS=45000
# Keep false for single-node/local dev. For multi-node production with route sharding, set true
# only after Redis is healthy and route-aware clients are deployed.
WORLD_ROUTE_ENFORCEMENT_ENABLED=false
# Set true while debugging join/reset issues to log refreshed world counts and PostgreSQL timestamps on world entry.
WORLD_STATE_REFRESH_TRACE=false
# Keep false if you want local fallback routing when Redis is unavailable.
REDIS_REQUIRED_FOR_ROUTE_ENFORCEMENT=false
# Optional helper knobs for `npm run prod:world-route`; enforcement defaults on for route sharding.
# Set ROUTE_PRODUCTION_ENFORCEMENT_ENABLED=false only for an emergency single-route fallback.
ROUTE_PRODUCTION_PORT_A=18091
ROUTE_PRODUCTION_PORT_B=18092
ROUTE_PRODUCTION_BASE_WS_URL=wss://api.pixelmaniagame.com
ROUTE_PRODUCTION_ENFORCEMENT_ENABLED=true

# Optional Netfox ENet movement server world-state auth.
# Set the same raw token on the Godot Netfox server as PIXELMANIA_NETFOX_SERVER_TOKEN
# or pass it with --netfox-server-token. Prefer the hash form on hosted backends.
NETFOX_SERVER_WORLD_STATE_TOKEN=
NETFOX_SERVER_WORLD_STATE_TOKEN_HASH=
NETFOX_MOVEMENT_ENABLED=true
NETFOX_TRUSTED_PLAYER_STATE_ENABLED=true
CUSTOM_TRUSTED_PLAYER_STATE_ENABLED=false
TRUSTED_MOVEMENT_REQUIRE_JOINED_WORLD=true
TRUSTED_MOVEMENT_ALLOWLIST_ENABLED=false
# Comma-separated account names allowed to use trusted movement modes.
TRUSTED_MOVEMENT_ALLOWLIST=
NETFOX_MOVEMENT_ALLOW_STATIC_FALLBACK=false
NETFOX_MOVEMENT_ROUTE_TTL_MS=45000
NETFOX_SPAWN_TICKET_SECRET=

# Optional object storage target for large world snapshot archives.
# When set to spaces, snapshots are written locally first, then uploaded to Spaces/S3.
# PostgreSQL remains the permanent truth database and stores the snapshot checksum + storage URI.
WORLD_SNAPSHOT_STORAGE=local
# WORLD_SNAPSHOT_SPACES_REGION=tor1
# WORLD_SNAPSHOT_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
# WORLD_SNAPSHOT_SPACES_TARGET=s3://pixelmania-backups/world_snapshots
# WORLD_SNAPSHOT_POSTGRES_INLINE=false
