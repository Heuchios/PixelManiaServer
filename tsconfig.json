{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "maxNodeModuleJsDepth": 0,
    "module": "CommonJS",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "*.js",
    "scripts/**/*.js",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    ".tsbuild",
    "node_modules",
    "ops_dashboard_public",
    "src/server.ts",
    "world_snapshots",
    "worlds",
    "players",
    "src/postgres_store.ts"
  ]
}
