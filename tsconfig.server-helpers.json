{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "noEmit": false,
    "outDir": ".tsbuild",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/server_identity_helpers.ts",
    "src/server_text_helpers.ts",
    "src/server_version_helpers.ts",
    "src/server_account_helpers.ts"
  ],
  "exclude": ["node_modules"]
}
